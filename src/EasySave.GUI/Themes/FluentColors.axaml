            <SolidColorBrush x:Key="EsPressedBg">#22FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="EsSelectedBg">#1A00B4A6</SolidColorBrush>
            <SolidColorBrush x:Key="EsSelectedBorder">#6000B4A6</SolidColorBrush>

            <!-- Sidebar -->
            <SolidColorBrush x:Key="EsSidebarHover">#22FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="EsSidebarPressed">#33FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="EsSidebarActive">#1A00B4A6</SolidColorBrush>

            <!-- Window Controls -->
