            <SolidColorBrush x:Key="EsPaginationBorder">#11FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="EsPaginationBtnBorder">#22FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="EsPaginationBtnFg">#BBBBBB</SolidColorBrush>
