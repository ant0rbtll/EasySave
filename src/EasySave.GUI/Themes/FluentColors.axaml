            <SolidColorBrush x:Key="EsStatusActiveFg">#7AB8FF</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusPausedBg">#1F5A4A1A</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusPausedFg">#FFE082</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusDoneBg">#1A66BB6A</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusDoneFg">#66BB6A</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusErrorBg">#1AEF5350</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusErrorFg">#EF5350</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusBlockedBg">#2AAF3A3A</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusBlockedFg">#FFC8C8</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusWaitingBg">#2A8B5A2B</SolidColorBrush>
            <SolidColorBrush x:Key="EsStatusWaitingFg">#FFD59A</SolidColorBrush>

            <!-- Badges: ID -->
