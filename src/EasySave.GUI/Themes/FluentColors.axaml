            <SolidColorBrush x:Key="EsRuntimeWaitingBg">#2A8B5A2B</SolidColorBrush>
            <SolidColorBrush x:Key="EsRuntimeWaitingFg">#FFD59A</SolidColorBrush>
            <SolidColorBrush x:Key="EsRuntimeStopRequestedBg">#2AAF3A3A</SolidColorBrush>
            <SolidColorBrush x:Key="EsRuntimeStopRequestedFg">#FFC8C8</SolidColorBrush>

            <!-- Batch Buttons -->
            <SolidColorBrush x:Key="EsBatchPlayBg">#1A66BB6A</SolidColorBrush>
