            <SolidColorBrush x:Key="EsPauseFg">#FFE082</SolidColorBrush>
            <SolidColorBrush x:Key="EsPauseBorder">#5AFFD54F</SolidColorBrush>

            <!-- Semantic: Info/Active -->
