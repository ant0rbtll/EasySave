<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>

        <!-- ══════════════════════════════════════════ -->
        <!--                DARK MODE                   -->
        <!-- ══════════════════════════════════════════ -->
        <ResourceDictionary x:Key='Dark'>

            <!-- Backgrounds -->
            <SolidColorBrush x:Key="EsBackground">#1A1A2E</SolidColorBrush>
            <SolidColorBrush x:Key="EsSurfaceBase">#222238</SolidColorBrush>
            <SolidColorBrush x:Key="EsSurfaceElevated">#2A2A42</SolidColorBrush>
            <SolidColorBrush x:Key="EsSurfaceOverlay">#AA000000</SolidColorBrush>
            <SolidColorBrush x:Key="EsTitleBar">#161626</SolidColorBrush>
            <SolidColorBrush x:Key="EsSidebarBackground">#1E1E32</SolidColorBrush>

            <!-- Borders -->
            <SolidColorBrush x:Key="EsBorderSubtle">#1EFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="EsBorderMedium">#33FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="EsBorderStrong">#55FFFFFF</SolidColorBrush>

            <!-- Text -->
            <SolidColorBrush x:Key="EsTextPrimary">#F0F0F5</SolidColorBrush>
            <SolidColorBrush x:Key="EsTextSecondary">#B0B0C0</SolidColorBrush>
            <SolidColorBrush x:Key="EsTextTertiary">#8090A8</SolidColorBrush>
            <SolidColorBrush x:Key="EsTextDisabled">#505868</SolidColorBrush>
            <SolidColorBrush x:Key="EsTextOnAccent">#FFFFFF</SolidColorBrush>

            <!-- Accent (Teal) -->
            <SolidColorBrush x:Key="EsAccent">#00B4A6</SolidColorBrush>
            <SolidColorBrush x:Key="EsAccentHover">#00CFC0</SolidColorBrush>
            <SolidColorBrush x:Key="EsAccentPressed">#009A8E</SolidColorBrush>
            <SolidColorBrush x:Key="EsAccentSubtle">#1A00B4A6</SolidColorBrush>
            <SolidColorBrush x:Key="EsAccentForeground">#6FE8DC</SolidColorBrush>
            <SolidColorBrush x:Key="EsAccentBorderSubtle">#5500B4A6</SolidColorBrush>

            <!-- Semantic: Success -->
            <SolidColorBrush x:Key="EsSuccessBg">#1A66BB6A</SolidColorBrush>
            <SolidColorBrush x:Key="EsSuccessFg">#66BB6A</SolidColorBrush>
            <SolidColorBrush x:Key="EsSuccessBorder">#4CAF50</SolidColorBrush>

            <!-- Semantic: Error -->
            <SolidColorBrush x:Key="EsErrorBg">#1AEF5350</SolidColorBrush>
            <SolidColorBrush x:Key="EsErrorFg">#EF5350</SolidColorBrush>
            <SolidColorBrush x:Key="EsErrorBorder">#EF5350</SolidColorBrush>

            <!-- Semantic: Warning -->
            <SolidColorBrush x:Key="EsWarningBg">#33FFA726</SolidColorBrush>
            <SolidColorBrush x:Key="EsWarningFg">#FFA726</SolidColorBrush>
            <SolidColorBrush x:Key="EsWarningBorder">#FFB74D</SolidColorBrush>

            <!-- Semantic: Pause -->
