<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasySave.GUI.ViewModels"
             x:Class="EasySave.GUI.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">

    <StackPanel Margin="8,8">
        <!-- Hamburger toggle button -->
        <Button Classes="sidebar-item"
                ToolTip.Tip="{Binding ToggleTooltip}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSidebarCommand}"
                Margin="0,0,0,4">
            <PathIcon Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                      Width="20" Height="20"/>
        </Button>

        <Separator Margin="20,4"/>

        <!-- Create -->
        <Grid>
            <Border Width="3" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                    Background="{DynamicResource EsAccent}"
                    IsVisible="{Binding IsCreateActive}"
                    Margin="-8,2,0,2"/>
            <Button Classes="sidebar-item"
                    Classes.active="{Binding IsCreateActive}"
                    Command="{Binding GoToCreateCommand}"
                    ToolTip.Tip="{Binding CreateLabel}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
                    <TextBlock Text="{Binding CreateLabel}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsExpanded}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Separator Margin="20,4"/>

        <!-- Manage -->
        <Grid>
            <Border Width="3" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                    Background="{DynamicResource EsAccent}"
                    IsVisible="{Binding IsManageActive}"
                    Margin="-8,2,0,2"/>
            <Button Classes="sidebar-item"
                    Classes.active="{Binding IsManageActive}"
                    Command="{Binding GoToManageCommand}"
                    ToolTip.Tip="{Binding ManageLabel}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
                    <TextBlock Text="{Binding ManageLabel}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsExpanded}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Separator Margin="20,4"/>

        <!-- Progress -->
        <Grid>
            <Border Width="3" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                    Background="{DynamicResource EsAccent}"
                    IsVisible="{Binding IsProgressActive}"
                    Margin="-8,2,0,2"/>
            <Button Classes="sidebar-item"
                    Classes.active="{Binding IsProgressActive}"
                    Command="{Binding GoToProgressCommand}"
                    ToolTip.Tip="{Binding ProgressLabel}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M3 13h2v8H3v-8zm8-6h2v14h-2V7zm8-4h2v18h-2V3z"/>
                    <TextBlock Text="{Binding ProgressLabel}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsExpanded}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Separator Margin="20,4"/>

        <!-- Log -->
        <Grid>
            <Border Width="3" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                    Background="{DynamicResource EsAccent}"
                    IsVisible="{Binding IsLogActive}"
                    Margin="-8,2,0,2"/>
            <Button Classes="sidebar-item"
                    Classes.active="{Binding IsLogActive}"
                    Command="{Binding GoToLogCommand}"
                    ToolTip.Tip="{Binding LogLabel}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                    <TextBlock Text="{Binding LogLabel}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsExpanded}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Separator Margin="20,4"/>

        <!-- Config -->
        <Grid>
            <Border Width="3" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                    Background="{DynamicResource EsAccent}"
                    IsVisible="{Binding IsConfigActive}"
                    Margin="-8,2,0,2"/>
            <Button Classes="sidebar-item"
                    Classes.active="{Binding IsConfigActive}"
                    Command="{Binding GoToConfigCommand}"
                    ToolTip.Tip="{Binding ConfigLabel}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 00-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1112 8.4a3.6 3.6 0 010 7.2z"/>
                    <TextBlock Text="{Binding ConfigLabel}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsExpanded}"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
