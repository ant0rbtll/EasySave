<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasySave.GUI.ViewModels"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="EasySave.GUI.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">
    <UserControl.Styles>
        <Style Selector="primitives|ToggleButton.log-format">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="primitives|ToggleButton.log-format:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="500" HorizontalAlignment="Left">

            <TextBlock Text="{Binding TitleText}" FontSize="24" FontWeight="Bold"/>

            <!-- Langue -->
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding LanguageText}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          SelectedValueBinding="{Binding Code}"
                          SelectedValue="{Binding SelectedLanguage}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Format de logs -->
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding LogFormatText}" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <primitives:ToggleButton Classes="log-format"
                                             Content="{Binding LogFormatJsonText}"
                                             IsChecked="{Binding IsJsonLogFormatSelected, Mode=OneWay}"
                                             Command="{Binding SelectJsonLogFormatCommand}"/>
                    <primitives:ToggleButton Classes="log-format"
                                             Content="{Binding LogFormatXmlText}"
                                             IsChecked="{Binding IsXmlLogFormatSelected, Mode=OneWay}"
                                             Command="{Binding SelectXmlLogFormatCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Dossier de logs -->
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding LogDirectoryText}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                    <TextBox Grid.Column="0"
                             Text="{Binding LogDirectory}"
                             Watermark="{Binding LogDirectoryWatermark}"/>
                    <Button Grid.Column="1"
                            Content="{Binding BrowseText}"
                            Command="{Binding BrowseLogDirectoryCommand}"
                            Margin="8,0,0,0"/>
                </Grid>
                <!-- Erreur de validation -->
                <TextBlock Text="{Binding PathError}"
                           Foreground="#F44336"
                           FontSize="12"
                           IsVisible="{Binding PathError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                <Button Content="{Binding ResetText}"
                        Command="{Binding ResetLogDirectoryCommand}"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Logiciels métier -->
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding BusinessSoftwareText}" FontWeight="SemiBold"/>

                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                    <TextBox Grid.Column="0"
                             Text="{Binding NewBusinessSoftwareInput}"
                             Watermark="{Binding BusinessSoftwareWatermark}"/>
                    <Button Grid.Column="1"
                            Content="{Binding BusinessSoftwareAddText}"
                            Command="{Binding AddBusinessSoftwareCommand}"
                            Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="{Binding BusinessSoftwareEmptyText}"
                           Foreground="#8FA3B8"
                           FontSize="12"
                           IsVisible="{Binding !BusinessSoftwareProcesses.Count}"/>

                <ItemsControl ItemsSource="{Binding BusinessSoftwareProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Padding="8,4" Margin="0,2"
                                    Background="#22FFFFFF" CornerRadius="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding}"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas,monospace"
                                               FontSize="13"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).RemoveBusinessSoftwareCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="4"
                                            Background="Transparent">
                                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Foreground="#EF5350"
                                                  Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Extensions chiffrées -->
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding EncryptedExtensionsText}" FontWeight="SemiBold"/>

                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                    <TextBox Grid.Column="0"
                             Text="{Binding NewExtensionInput}"
                             Watermark="{Binding EncryptedExtensionsWatermark}"/>
                    <Button Grid.Column="1"
                            Content="{Binding EncryptedExtensionsAddText}"
                            Command="{Binding AddExtensionCommand}"
                            Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="{Binding EncryptedExtensionsEmptyText}"
                           Foreground="#8FA3B8"
                           FontSize="12"
                           IsVisible="{Binding !EncryptedExtensions.Count}"/>

                <ItemsControl ItemsSource="{Binding EncryptedExtensions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Padding="8,4" Margin="0,2"
                                    Background="#22FFFFFF" CornerRadius="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding}"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas,monospace"
                                               FontSize="13"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).RemoveExtensionCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="4"
                                            Background="Transparent">
                                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Foreground="#EF5350"
                                                  Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Sauvegarder -->
            <Button Content="{Binding SaveText}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left"
                    Classes="accent"/>

            <!-- Message de statut -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#4CAF50"
                       IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
