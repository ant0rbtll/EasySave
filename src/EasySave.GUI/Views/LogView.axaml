<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasySave.GUI.ViewModels"
             xmlns:models="using:EasySave.GUI.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="EasySave.GUI.Views.LogView"
             x:DataType="vm:LogViewModel">

	<Panel Margin="24">
		<StackPanel Spacing="20" IsVisible="{Binding !IsDateSelected}">
			<Grid ColumnDefinitions="*, Auto">
				<StackPanel Grid.Column="0">
					<TextBlock Text="{Binding HistoryTitle}" FontSize="22" FontWeight="Bold"/>
					<TextBlock Text="{Binding HistorySubtitle}" Foreground="#888" FontSize="13"/>
				</StackPanel>

				<TextBox Grid.Column="1"
                         Width="300"
                         Text="{Binding SearchTextDate}"
                         Watermark="{Binding SearchDateWatermark}"
                         VerticalAlignment="Top">
					<TextBox.InnerLeftContent>
						<PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Width="16" Height="16" Margin="10,0,0,0" Opacity="0.5"/>
					</TextBox.InnerLeftContent>
				</TextBox>
			</Grid>

			<Border BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8">
				<ItemsControl ItemsSource="{Binding AvailableDates}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Classes="action-btn"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:LogViewModel)DataContext).SelectDateCommand}"
                                    CommandParameter="{Binding}">
								<StackPanel Orientation="Horizontal" Spacing="15" >
									<PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.9 20.1,3 19,3H18V1M17,12H12V17H17V12Z" Foreground="#66BBFF"/>
									<TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="15"/>
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
		</StackPanel>

		<Grid RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsDateSelected}">
			<Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20">
				<Button Grid.Column="0" Command="{Binding GoBackCommand}" Background="Transparent" Margin="0,0,15,0">
					<PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
				</Button>

				<StackPanel Grid.Column="1">
					<TextBlock Text="{Binding SelectedDate, StringFormat='Logs : \{0\}'}" FontSize="22" FontWeight="Bold"/>
					<TextBlock Text="{Binding LogDetailSubtitle}" Foreground="#888" FontSize="13"/>
				</StackPanel>

				<TextBox Grid.Column="2"
                         Width="300"
                         Text="{Binding SearchText}"
                         Watermark="{Binding SearchLogWatermark}"
                         VerticalAlignment="Top">
					<TextBox.InnerLeftContent>
						<PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Width="16" Height="16" Margin="10,0,0,0" Opacity="0.5"/>
					</TextBox.InnerLeftContent>
				</TextBox>
			</Grid>

			<Border Grid.Row="1" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
				<Grid RowDefinitions="Auto,*">
					<Border Background="#11FFFFFF" Padding="15,10">
						<Grid ColumnDefinitions="80,120,100,*,*,100,80,80">
							<TextBlock Grid.Column="0" Text="{Binding ColTime}" Foreground="#999" FontSize="11" FontWeight="Bold"/>
							<TextBlock Grid.Column="1" Text="{Binding ColName}" Foreground="#999" FontSize="11" FontWeight="Bold"/>
							<TextBlock Grid.Column="2" Text="{Binding ColStatus}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
							<TextBlock Grid.Column="3" Text="{Binding ColSource}" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="10,0"/>
							<TextBlock Grid.Column="4" Text="{Binding ColDest}" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="10,0"/>
							<TextBlock Grid.Column="5" Text="{Binding ColSize}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
							<TextBlock Grid.Column="6" Text="{Binding ColDuration}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
							<TextBlock Grid.Column="7" Text="{Binding ColEncryption}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
						</Grid>
					</Border>

					<ScrollViewer Grid.Row="1">
						<ItemsControl ItemsSource="{Binding LogEntries}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="models:LogDisplayModel">
									<Border BorderBrush="#11FFFFFF" BorderThickness="0,0,0,1" Padding="15,10" Classes="log-row">
										<Grid ColumnDefinitions="80,120,100,*,*,100,80,80">
											<TextBlock Grid.Column="0" Text="{Binding Timestamp}" VerticalAlignment="Center" FontSize="12"/>
											<TextBlock Grid.Column="1"
                                                       Text="{Binding BackupName}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
												<ToolTip.Tip>
													<TextBlock Text="{Binding BackupName}"
                                                               TextWrapping="NoWrap"
                                                               MaxWidth="1000" />
												</ToolTip.Tip>
											</TextBlock>

											<Border Grid.Column="2" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
												<Border.Styles>
													<Style Selector="Border[Tag=TransferFile]">
														<Setter Property="Background" Value="#224CAF50"/>
													</Style>
													<Style Selector="Border[Tag=TransferFile] TextBlock">
														<Setter Property="Foreground" Value="#81C784"/>
														<Setter Property="Text" Value="TRANSFERT"/>
													</Style>
													<Style Selector="Border[Tag=CreateDirectory]">
														<Setter Property="Background" Value="#222196F3"/>
													</Style>
													<Style Selector="Border[Tag=CreateDirectory] TextBlock">
														<Setter Property="Foreground" Value="#64B5F6"/>
														<Setter Property="Text" Value="DOSSIER"/>
													</Style>
													<Style Selector="Border[Tag=Error]">
														<Setter Property="Background" Value="#22EF5350"/>
													</Style>
													<Style Selector="Border[Tag=Error] TextBlock">
														<Setter Property="Foreground" Value="#EF9A9A"/>
														<Setter Property="Text" Value="ERREUR"/>
													</Style>
												</Border.Styles>
												<Border.Tag>
													<Binding Path="EventType"/>
												</Border.Tag>
												<TextBlock FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
											</Border>

											<TextBlock Grid.Column="3"
                                                       Text="{Binding Source}"
                                                       Classes="path-text"
                                                       VerticalAlignment="Center"
                                                       Margin="20,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Source}"/>

											<TextBlock Grid.Column="4"
                                                       Text="{Binding Destination}"
                                                       Classes="path-text"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Destination}"/>

											<TextBlock Grid.Column="5" Text="{Binding FileSize}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>

											<TextBlock Grid.Column="6" Text="{Binding Duration}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#66BBFF"/>

											<TextBlock Grid.Column="7" Text="{Binding EncryptionTime}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#FFAB40"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Panel>
</UserControl>