<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasySave.GUI.ViewModels"
             xmlns:models="using:EasySave.GUI.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="EasySave.GUI.Views.LogView"
             x:DataType="vm:LogViewModel">

    <UserControl.Styles>
        <Style Selector="Border.pagination-row">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#11FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style Selector="Button.page-nav-btn">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.page-nav-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>
        <Style Selector="Button.page-nav-btn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="Button.page-item-btn">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.page-item-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF"/>
        </Style>
        <Style Selector="Button.page-item-btn.current">
            <Setter Property="Background" Value="#1F42A5F5"/>
            <Setter Property="BorderBrush" Value="#6042A5F5"/>
            <Setter Property="Foreground" Value="#D3E9FF"/>
        </Style>
        <Style Selector="TextBlock.page-ellipsis">
            <Setter Property="Foreground" Value="#7D8B99"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.page-meta">
            <Setter Property="Foreground" Value="#8FA3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.page-input">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.page-go-btn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.page-go-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="ComboBox.page-size">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </UserControl.Styles>

	<Panel Margin="24">

		<StackPanel Spacing="20" IsVisible="{Binding !IsDateSelected}">
			<Grid ColumnDefinitions="*, Auto, Auto">
				<StackPanel Grid.Column="0">
					<TextBlock Text="{Binding HistoryTitle}" FontSize="22" FontWeight="Bold"/>
					<TextBlock Text="{Binding HistorySubtitle}" Foreground="#888" FontSize="13"/>
				</StackPanel>

				<Button Grid.Column="1"
						Command="{Binding LoadDatesCommand}"
						Width="30"
						Height="30"
						Padding="0"
						Margin="0,0,12,0"
						VerticalAlignment="Top"
						ToolTip.Tip="Refresh dates">
					<Button.Styles>
						<Style Selector="Button">
							<Setter Property="Background" Value="Transparent"/>
						</Style>
					</Button.Styles>
					<PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
							  Width="18"
							  Height="18"
							  Foreground="#66BBFF"/>
				</Button>

				<TextBox Grid.Column="2"
						 Width="300"
						 Text="{Binding SearchTextDate}"
						 Watermark="{Binding SearchDateWatermark}"
						 VerticalAlignment="Top">
					<TextBox.InnerLeftContent>
						<PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
								  Width="16" Height="16" Margin="10,0,0,0" Opacity="0.5"/>
					</TextBox.InnerLeftContent>
				</TextBox>
			</Grid>

			<Border BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8">
				<ItemsControl ItemsSource="{Binding AvailableDates}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Classes="action-btn"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:LogViewModel)DataContext).SelectDateCommand}"
                                    CommandParameter="{Binding}">
								<StackPanel Orientation="Horizontal" Spacing="15" >
									<PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.9 20.1,3 19,3H18V1M17,12H12V17H17V12Z" Foreground="#66BBFF"/>
									<TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="15"/>
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
		</StackPanel>

		<Grid RowDefinitions="Auto,*" Margin="20" IsVisible="{Binding IsDateSelected}">

			<Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20">
				<Button Grid.Column="0" Command="{Binding GoBackCommand}" Background="Transparent" Margin="0,0,15,0">
					<PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
				</Button>

				<StackPanel Grid.Column="1">
					<TextBlock Text="{Binding SelectedDate, StringFormat='Logs : \{0\}'}" FontSize="22" FontWeight="Bold"/>
					<TextBlock Text="{Binding LogDetailSubtitle}" Foreground="#888" FontSize="13"/>
				</StackPanel>

				<TextBox Grid.Column="2"
                         Width="300"
                         Text="{Binding SearchText}"
                         Watermark="{Binding SearchLogWatermark}"
                         VerticalAlignment="Top">
					<TextBox.InnerLeftContent>
						<PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Width="16" Height="16" Margin="10,0,0,0" Opacity="0.5"/>
					</TextBox.InnerLeftContent>
				</TextBox>
			</Grid>

			<Border Grid.Row="1" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
				<Grid RowDefinitions="Auto,*,Auto">

					<Border Background="#11FFFFFF" Padding="15,10">
						<Grid ColumnDefinitions="80,120,100,*,*,100,80,80">
							<TextBlock Grid.Column="0" Text="{Binding ColTime}" Foreground="#999" FontSize="11" FontWeight="Bold"/>
							<TextBlock Grid.Column="1" Text="{Binding ColName}" Foreground="#999" FontSize="11" FontWeight="Bold"/>
							<TextBlock Grid.Column="2" Text="{Binding ColStatus}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
							<TextBlock Grid.Column="3" Text="{Binding ColSource}" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="10,0"/>
							<TextBlock Grid.Column="4" Text="{Binding ColDest}" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="10,0"/>
							<TextBlock Grid.Column="5" Text="{Binding ColSize}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
							<TextBlock Grid.Column="6" Text="{Binding ColDuration}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
							<TextBlock Grid.Column="7" Text="{Binding ColEncryption}" Foreground="#999" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
						</Grid>
					</Border>

					<ScrollViewer Grid.Row="1">
						<ItemsControl ItemsSource="{Binding LogEntries}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="models:LogDisplayModel">
									<Border BorderBrush="#11FFFFFF" BorderThickness="0,0,0,1" Padding="15,10" Classes="log-row">
										<Grid ColumnDefinitions="80,120,100,*,*,100,80,80">
											<TextBlock Grid.Column="0" Text="{Binding Timestamp}" VerticalAlignment="Center" FontSize="12"/>
											<TextBlock Grid.Column="1"
                                                       Text="{Binding BackupName}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
												<ToolTip.Tip>
													<TextBlock Text="{Binding BackupName}"
                                                               TextWrapping="NoWrap"
                                                               MaxWidth="1000" />
												</ToolTip.Tip>
											</TextBlock>

											<Border Grid.Column="2" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
												<Border.Styles>
													<Style Selector="Border[Tag=TransferFile]">
														<Setter Property="Background" Value="#224CAF50"/>
													</Style>
													<Style Selector="Border[Tag=TransferFile] TextBlock">
														<Setter Property="Foreground" Value="#81C784"/>
														<Setter Property="Text" Value="TRANSFERT"/>
													</Style>

													<Style Selector="Border[Tag=CreateDirectory]">
														<Setter Property="Background" Value="#222196F3"/>
													</Style>
													<Style Selector="Border[Tag=CreateDirectory] TextBlock">
														<Setter Property="Foreground" Value="#64B5F6"/>
														<Setter Property="Text" Value="DOSSIER"/>
													</Style>

													<Style Selector="Border[Tag=Error]">
														<Setter Property="Background" Value="#22EF5350"/>
													</Style>
													<Style Selector="Border[Tag=Error] TextBlock">
														<Setter Property="Foreground" Value="#EF9A9A"/>
														<Setter Property="Text" Value="ERREUR"/>
													</Style>

													<Style Selector="Border[Tag=StartBackup]">
														<Setter Property="Background" Value="#229C27B0"/>
													</Style>
													<Style Selector="Border[Tag=StartBackup] TextBlock">
														<Setter Property="Foreground" Value="#CE93D8"/>
														<Setter Property="Text" Value="DEBUT"/>
													</Style>

													<Style Selector="Border[Tag=EndBackup]">
														<Setter Property="Background" Value="#22009688"/>
													</Style>
													<Style Selector="Border[Tag=EndBackup] TextBlock">
														<Setter Property="Foreground" Value="#80CBC4"/>
														<Setter Property="Text" Value="FIN"/>
													</Style>
												</Border.Styles>

												<Border.Tag>
													<Binding Path="EventType"/>
												</Border.Tag>
												<TextBlock FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
											</Border>

											<TextBlock Grid.Column="3" Text="{Binding Source}" Classes="path-text" VerticalAlignment="Center" Margin="20,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}"/>
											<TextBlock Grid.Column="4" Text="{Binding Destination}" Classes="path-text" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Destination}"/>
											<TextBlock Grid.Column="5" Text="{Binding FileSize}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
											<TextBlock Grid.Column="6" Text="{Binding Duration}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#66BBFF"/>
											<TextBlock Grid.Column="7" Text="{Binding EncryptionTime}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#FFAB40"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

                    <Border Grid.Row="2"
                            Classes="pagination-row"
                            Padding="12,8"
                            IsVisible="{Binding IsPaginationVisible}">
                        <Grid ColumnDefinitions="*,Auto"
                              VerticalAlignment="Center">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Classes="page-nav-btn"
                                        Command="{Binding PreviousPageCommand}">
                                    <TextBlock Text="◀" FontSize="12"/>
                                </Button>

                                <ItemsControl ItemsSource="{Binding PaginationItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaginationItem">
                                            <Grid>
                                                <Button IsVisible="{Binding IsPage}"
                                                        Classes="page-item-btn"
                                                        Classes.current="{Binding IsCurrent}"
                                                        IsEnabled="{Binding IsSelectable}"
                                                        Command="{Binding $parent[UserControl].((vm:LogViewModel)DataContext).GoToPageCommand}"
                                                        CommandParameter="{Binding PageNumber}">
                                                    <TextBlock Text="{Binding Label}"/>
                                                </Button>
                                                <TextBlock IsVisible="{Binding IsEllipsis}"
                                                           Text="{Binding Label}"
                                                           Classes="page-ellipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Classes="page-nav-btn"
                                        Command="{Binding NextPageCommand}">
                                    <TextBlock Text="▶" FontSize="12"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageDisplay}"
                                           Classes="page-meta"/>

                                <TextBlock Text="|"
                                           Classes="page-meta"/>

                                <TextBox Classes="page-input"
                                         Text="{Binding PageInputText}"
                                         Watermark="{Binding PageJumpWatermark}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding JumpToEnteredPageCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <Button Classes="page-go-btn"
                                        Command="{Binding JumpToEnteredPageCommand}">
                                    <TextBlock Text="↵" FontSize="13"/>
                                </Button>

                                <TextBlock Text="|"
                                           Classes="page-meta"/>

                                <ComboBox Classes="page-size"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding SelectedPageSize}"/>

                                <TextBlock Text="/page"
                                           Classes="page-meta"/>
                            </StackPanel>
                        </Grid>
                    </Border>
				</Grid>
			</Border>
		</Grid>
	</Panel>
</UserControl>
