<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EasySave.GUI.ViewModels"
    xmlns:conv="using:Avalonia.Data.Converters"
    x:Class="EasySave.GUI.Views.CreateView"
    x:DataType="vm:CreateViewModel">

	<StackPanel Spacing="20" MaxWidth="800" Margin="24">

		<StackPanel>
			<!-- HEADER -->
			<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
				<StackPanel Spacing="4" Margin="0,0,0,4">
					<TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>
					<TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource EsTextTertiary}"/>
				</StackPanel>
			</Grid>
			<StackPanel Spacing="20" MaxWidth="800">

				<!-- SUCCESS BANNER -->
				<Border
					IsVisible="{Binding IsSuccessMessageVisible}"
					Background="{DynamicResource EsSuccessBg}"
					BorderBrush="{DynamicResource EsSuccessBorder}"
					BorderThickness="1"
					CornerRadius="6"
					Padding="12,10">
					<TextBlock
						Text="{Binding SuccessMessage}"
						Foreground="{DynamicResource EsSuccessFg}"
						FontWeight="SemiBold"
						TextAlignment="Center"/>
				</Border>

				<!-- ERROR BANNER -->
				<Border
					IsVisible="{Binding IsErrorMessageVisible}"
					Background="{DynamicResource EsErrorBg}"
					CornerRadius="6"
					Padding="12,8">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Grid.Column="0"
								   Text="{Binding ErrorMessage}"
								   Foreground="{DynamicResource EsErrorFg}"
								   FontWeight="SemiBold"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"/>
						<Button Grid.Column="1"
								Content="&#x2715;"
								Command="{Binding DismissErrorCommand}"
								Background="Transparent"
								BorderThickness="0"
								Foreground="{DynamicResource EsErrorFg}"
								FontSize="14"
								Padding="4"
								Cursor="Hand"
								VerticalAlignment="Center"/>
					</Grid>
				</Border>

				<!-- FORM CARD -->
				<Border
					BorderBrush="{DynamicResource EsFormCardBorder}"
					BorderThickness="1"
					CornerRadius="8"
					Padding="24,20"
					Background="{DynamicResource EsFormCardBg}">
					<StackPanel Spacing="18">

						<!-- Backup Name -->
						<StackPanel Spacing="6">
							<TextBlock Text="{Binding BackupNameLabel}" Classes="field-label"/>
							<TextBox Text="{Binding Name}" LostFocus="Name_LostFocus"/>
							<TextBlock Text="{Binding JobNameError}" Classes="field-error"
									   IsVisible="{Binding JobNameError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<!-- Source Path -->
						<StackPanel Spacing="6">
							<TextBlock Text="{Binding SourceLabel}" Classes="field-label"/>
							<Grid ColumnDefinitions="*,Auto">
								<TextBox Grid.Column="0"
										 Text="{Binding SourcePath}"
										 LostFocus="Source_LostFocus"/>
								<Button Grid.Column="1"
										Classes="btn-browse"
										Content="{Binding BrowseButtonLabel}"
										Click="BrowseSource_Click"
										Margin="8,0,0,0"/>
							</Grid>
							<TextBlock Text="{Binding SourcePathError}" Classes="field-error"
									   IsVisible="{Binding SourcePathError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<!-- Destination Path -->
						<StackPanel Spacing="6">
							<TextBlock Text="{Binding DestinationLabel}" Classes="field-label"/>
							<Grid ColumnDefinitions="*,Auto">
								<TextBox Grid.Column="0"
										 Text="{Binding DestinationPath}"
										 LostFocus="Destination_LostFocus"/>
								<Button Grid.Column="1"
										Classes="btn-browse"
										Content="{Binding BrowseButtonLabel}"
										Click="BrowseDestination_Click"
										Margin="8,0,0,0"/>
							</Grid>
							<TextBlock Text="{Binding DestinationPathError}" Classes="field-error"
									   IsVisible="{Binding DestinationPathError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>

						<!-- Backup Type -->
						<StackPanel Spacing="6">
							<TextBlock Text="{Binding BackupTypeLabel}" Classes="field-label"/>
							<ComboBox ItemsSource="{Binding BackupTypeOptions}"
									  SelectedValueBinding="{Binding Value}"
									  SelectedValue="{Binding SelectedBackupType}"
									  IsEditable="False"
									  HorizontalAlignment="Stretch"/>
						</StackPanel>

						<!-- BUTTONS -->
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right"
									Spacing="12">
							<Button Classes="btn-secondary"
									Content="{Binding CancelButtonLabel}"
									Command="{Binding CancelCommand}"/>
							<Button Classes="btn-primary"
									Content="{Binding CreateJobButtonLabel}"
									Command="{Binding CreateJobCommand}"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</StackPanel>
		</StackPanel>
	</StackPanel>
</UserControl>
