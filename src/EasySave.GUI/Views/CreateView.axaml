<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EasySave.GUI.ViewModels"
    x:Class="EasySave.GUI.Views.CreateView"
    x:DataType="vm:CreateViewModel">

	<!-- CONTENEUR UNIQUE -->
	<Grid RowDefinitions="Auto,*" Margin="20">

		<!-- HEADER -->
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
			<StackPanel Grid.Column="0">
				<TextBlock Text="Création d'un travail"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
				<TextBlock Text="Créez votre travail de sauvegarde"
                           FontSize="13"
                           Foreground="#888"/>
			</StackPanel>
		</Grid>

		<!-- FORMULAIRE -->
		<StackPanel Grid.Row="1" Spacing="10">

			<TextBlock Text="Nom du backup" />
			<TextBox Text="{Binding Name}" />

			<TextBlock Text="Source" />
			<DockPanel>
				<TextBox
                    Text="{Binding SourcePath}"
                    Width="300"
                    IsReadOnly="True" />
				<Button
                    Content="Parcourir..."
                    Click="BrowseSource_Click"
                    Margin="5,0,0,0"/>
			</DockPanel>

			<TextBlock Text="Destination" />
			<DockPanel>
				<TextBox
                    Text="{Binding DestinationPath}"
                    Width="300"
                    IsReadOnly="True" />
				<Button
                    Content="Parcourir..."
                    Click="BrowseDestination_Click"
                    Margin="5,0,0,0"/>
			</DockPanel>

			<TextBlock Text="Type de sauvegarde" />
			<ComboBox
                ItemsSource="{Binding BackupTypes}"
                SelectedItem="{Binding SelectedBackupType}"
                IsEditable="False" />

		</StackPanel>
		<!-- Boutons -->
		<StackPanel
			Orientation="Horizontal"
			HorizontalAlignment="Right"
			Spacing="10"
			Margin="0,20,0,0">

			<Button Content="Annuler"
					Command="{Binding CancelCommand}" />

			<Button Content="Créer le travail"
					Command="{Binding CreateJobCommand}" />

		</StackPanel>


	</Grid>
</UserControl>
