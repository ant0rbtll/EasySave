<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasySave.GUI.ViewModels"
             xmlns:models="using:EasySave.GUI.Models"
             x:Class="EasySave.GUI.Views.ManageView"
             x:DataType="vm:ManageViewModel">

    <UserControl.Styles>
        <!-- Style for the type badge -->
        <Style Selector="Border.type-badge">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style Selector="Border.type-badge TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
        </Style>

        <!-- Style for the ID badge -->
        <Style Selector="Border.id-badge">
            <Setter Property="Background" Value="#2200AAFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="36"/>
        </Style>
        <Style Selector="Border.id-badge TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#66BBFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Row hover effect -->
        <Style Selector="Border.job-row">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.job-row:pointerover">
            <Setter Property="Background" Value="#11FFFFFF"/>
        </Style>

        <!-- Path text style -->
        <Style Selector="TextBlock.path-text">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Column header button style -->
        <Style Selector="Button.col-header">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.col-header:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.col-header TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#999"/>
        </Style>
        <Style Selector="Button.col-header:pointerover TextBlock">
            <Setter Property="Foreground" Value="#CCC"/>
        </Style>

        <!-- Action button style -->
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="Button.action-btn PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

        <!-- Running banner -->
        <Border Grid.Row="0"
                Background="#1A42A5F5"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12"
                IsVisible="{Binding IsRunning}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="{Binding RunningLabel}"
                           Foreground="#42A5F5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RunningJobName}"
                           Foreground="#42A5F5"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status banner (success) -->
        <Border Grid.Row="1"
                Background="#1A66BB6A"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12"
                IsVisible="{Binding IsStatusBannerVisible}">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsStatusBannerVisible"/>
                    <Binding Path="!IsStatusError"/>
                </MultiBinding>
            </Border.IsVisible>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#66BB6A"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="✕"
                        Command="{Binding DismissStatusBannerCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#66BB6A"
                        FontSize="14"
                        Padding="4"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Status banner (error) -->
        <Border Grid.Row="1"
                Background="#1AEF5350"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsStatusBannerVisible"/>
                    <Binding Path="IsStatusError"/>
                </MultiBinding>
            </Border.IsVisible>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#EF5350"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="✕"
                        Command="{Binding DismissStatusBannerCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#EF5350"
                        FontSize="14"
                        Padding="4"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding TitleText}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SubtitleText}"
                           FontSize="13"
                           Foreground="#888"/>
            </StackPanel>

            <TextBox Grid.Column="1"
                     Text="{Binding SearchText}"
                     Watermark="{Binding SearchWatermark}"
                     Width="250"
                     VerticalAlignment="Center">
                <TextBox.InnerRightContent>
                    <Button Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchText.Length}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Width="12" Height="12"
                                  Foreground="#888"/>
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>

        <!-- Column headers + list -->
        <Border Grid.Row="3"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">

                <!-- Column headers -->
                <Border Grid.Row="0"
                        Background="#11FFFFFF"
                        Padding="16,10">
                    <Grid ColumnDefinitions="50,*,1.5*,1.5*,100,130">
                        <Button Grid.Column="0" Classes="col-header"
                                Command="{Binding SortByCommand}" CommandParameter="Id"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding IdHeader}"/>
                        </Button>
                        <Button Grid.Column="1" Classes="col-header"
                                Command="{Binding SortByCommand}" CommandParameter="Name"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding NameHeader}"/>
                        </Button>
                        <Button Grid.Column="2" Classes="col-header"
                                Command="{Binding SortByCommand}" CommandParameter="Source"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SourceHeader}"/>
                        </Button>
                        <Button Grid.Column="3" Classes="col-header"
                                Command="{Binding SortByCommand}" CommandParameter="Destination"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DestinationHeader}"/>
                        </Button>
                        <Button Grid.Column="4" Classes="col-header"
                                Command="{Binding SortByCommand}" CommandParameter="Type"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TypeHeader}"/>
                        </Button>
                        <Button Grid.Column="5" Classes="col-header"
                                HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                            <TextBlock Text="{Binding ActionsHeader}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Job list -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BackupJob">
                                <Border Classes="job-row"
                                        BorderBrush="#11FFFFFF"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,10">
                                    <Grid ColumnDefinitions="50,*,1.5*,1.5*,100,130"
                                          VerticalAlignment="Center">

                                        <!-- ID -->
                                        <Border Grid.Column="0" Classes="id-badge"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id}"/>
                                        </Border>

                                        <!-- Name -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   ToolTip.Tip="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="250"/>

                                        <!-- Source -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Source}"
                                                   ToolTip.Tip="{Binding Source}"
                                                   Classes="path-text"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="250"/>

                                        <!-- Destination -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Destination}"
                                                   ToolTip.Tip="{Binding Destination}"
                                                   Classes="path-text"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="250"/>

                                        <!-- Type -->
                                        <Border Grid.Column="4" Classes="type-badge"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}"/>
                                        </Border>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Classes="action-btn"
                                                    ToolTip.Tip="{Binding $parent[UserControl].((vm:ManageViewModel)DataContext).TooltipRun}"
                                                    Command="{Binding $parent[UserControl].((vm:ManageViewModel)DataContext).RunJobCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="M8 5v14l11-7z" Foreground="#66BB6A"/>
                                            </Button>
                                            <Button Classes="action-btn"
                                                    ToolTip.Tip="{Binding $parent[UserControl].((vm:ManageViewModel)DataContext).TooltipModify}"
                                                    Command="{Binding $parent[UserControl].((vm:ManageViewModel)DataContext).ModifyJobCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Foreground="#42A5F5"/>
                                            </Button>
                                            <Button Classes="action-btn"
                                                    ToolTip.Tip="{Binding $parent[UserControl].((vm:ManageViewModel)DataContext).TooltipDelete}"
                                                    Command="{Binding $parent[UserControl].((vm:ManageViewModel)DataContext).DeleteJobCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Foreground="#EF5350"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <!-- Confirmation overlay -->
    <Border Background="#AA000000"
            IsVisible="{Binding IsConfirmDialogOpen}">
        <Border Background="#2D2D3D"
                CornerRadius="10"
                Padding="32,24"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 24 0 #60000000">
            <StackPanel Spacing="20">
                <TextBlock Text="{Binding ConfirmRunTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding ConfirmRunMessage}"
                               FontSize="14"
                               Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding PendingJob.Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="?"
                               FontSize="14"
                               Foreground="#BBBBBB"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Center">
                    <Button Content="{Binding BtnCancelText}"
                            Command="{Binding CancelRunCommand}"
                            Padding="20,8"
                            Background="#44FFFFFF"
                            Foreground="White"
                            CornerRadius="6"/>
                    <Button Content="{Binding BtnConfirmText}"
                            Command="{Binding ConfirmRunCommand}"
                            Padding="20,8"
                            Background="#66BB6A"
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="6"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Delete confirmation overlay -->
    <Border Background="#AA000000"
            IsVisible="{Binding IsDeleteDialogOpen}">
        <Border Background="#2D2D3D"
                CornerRadius="10"
                Padding="32,24"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 24 0 #60000000">
            <StackPanel Spacing="20">
                <TextBlock Text="{Binding ConfirmDeleteTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding ConfirmDeleteMessage}"
                               FontSize="14"
                               Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding PendingDeleteJob.Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="?"
                               FontSize="14"
                               Foreground="#BBBBBB"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Center">
                    <Button Content="{Binding BtnCancelText}"
                            Command="{Binding CancelDeleteCommand}"
                            Padding="20,8"
                            Background="#44FFFFFF"
                            Foreground="White"
                            CornerRadius="6"/>
                    <Button Content="{Binding BtnDeleteText}"
                            Command="{Binding ConfirmDeleteCommand}"
                            Padding="20,8"
                            Background="#EF5350"
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="6"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
