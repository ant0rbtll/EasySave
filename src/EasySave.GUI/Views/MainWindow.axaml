<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasySave.GUI.ViewModels"
        xmlns:views="using:EasySave.GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/easysave-icon.png"
        Title="EasySave">
    <Grid ColumnDefinitions="250,*" MinHeight="0">
        <views:SidebarView Grid.Column="0"
                           MinHeight="0"
                           DataContext="{Binding Sidebar}"/>
        <ScrollViewer Grid.Column="1"
                      MinHeight="0"
                      VerticalScrollBarVisibility="{Binding PageVerticalScrollBarVisibility}"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl MinHeight="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            Content="{Binding CurrentPage}"/>
        </ScrollViewer>
    </Grid>
</Window>
