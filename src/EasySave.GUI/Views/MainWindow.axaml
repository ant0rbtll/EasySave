<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasySave.GUI.ViewModels"
        xmlns:views="using:EasySave.GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/easysave-icon.png"
        Title="EasySave"
        MinWidth="1280"
        MinHeight="750"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40">

    <Grid x:Name="MainLayoutGrid" RowDefinitions="40,Auto,*">
        <!-- Barre de titre custom -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*,Auto"
              Background="{DynamicResource EsTitleBar}">

            <!-- Icone + Titre de l'app -->
            <StackPanel x:Name="TitleBarBrand" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        IsHitTestVisible="False">
                <Image x:Name="TitleBarLogo"
                       Source="/Assets/easysave-icon.png"
                       Width="20" Height="20"/>
                <TextBlock Text="EasySave"
                           Foreground="{DynamicResource EsTextPrimary}" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Spacer (zone de drag) -->
            <Border Grid.Column="2" Background="Transparent"
                    IsHitTestVisible="False"/>

            <!-- Boutons de fenêtre Linux (cachés par défaut) -->
            <StackPanel x:Name="LinuxWindowButtons" Grid.Column="3"
                        Orientation="Horizontal"
                        IsVisible="False"
                        VerticalAlignment="Stretch">
                <Button Classes="window-control"
                        x:Name="MinimizeButton"
                        ToolTip.Tip="{Binding TooltipMinimize}">
                    <PathIcon Data="M20 14H4v-2h16"
                              Width="10" Height="10"
                              Foreground="{DynamicResource EsTextPrimary}"/>
                </Button>
                <Button Classes="window-control"
                        x:Name="MaximizeButton"
                        ToolTip.Tip="{Binding TooltipMaximize}">
                    <PathIcon x:Name="MaximizeIcon"
                              Data="M4 4h16v16H4V4m2 2v12h12V6H6z"
                              Width="10" Height="10"
                              Foreground="{DynamicResource EsTextPrimary}"/>
                </Button>
                <Button Classes="window-control window-close"
                        x:Name="CloseButton"
                        ToolTip.Tip="{Binding TooltipClose}">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Width="10" Height="10"
                              Foreground="{DynamicResource EsTextPrimary}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Log server warning banner -->
        <Border Grid.Row="1"
                Background="{DynamicResource EsWarningBg}"
                Padding="12,8"
                IsVisible="{Binding IsLogServerWarningVisible}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                          Width="16" Height="16"
                          Foreground="{DynamicResource EsWarningFg}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LogServerWarningMessage}"
                           Foreground="{DynamicResource EsWarningFg}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" MinHeight="0">
            <Border Grid.Column="0"
                    Width="{Binding SidebarWidth}"
                    Background="{DynamicResource EsSidebarBackground}"
                    BorderBrush="{DynamicResource EsBorderSubtle}"
                    BorderThickness="0,0,1,0"
                    MinHeight="0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseInOut"/>
                    </Transitions>
                </Border.Transitions>
                <views:SidebarView MinHeight="0"
                                   DataContext="{Binding Sidebar}"/>
            </Border>
            <ScrollViewer Grid.Column="1"
                          MinHeight="0"
                          IsVisible="{Binding UseGlobalScroll}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl MinHeight="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                Content="{Binding ScrollablePage}"/>
            </ScrollViewer>
            <ContentControl Grid.Column="1"
                            MinHeight="0"
                            IsVisible="{Binding !UseGlobalScroll}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding FixedPage}"/>
        </Grid>

        <Border Grid.RowSpan="3"
                Background="{DynamicResource EsSurfaceOverlay}"
                IsVisible="{Binding IsCloseDialogOpen}">
            <Border Background="{DynamicResource EsDialogBg}"
                    CornerRadius="10"
                    Padding="32,24"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #60000000">
                <StackPanel Spacing="20">
                    <TextBlock Text="{Binding CloseDialogTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CloseDialogMessage}"
                               FontSize="14"
                               Foreground="{DynamicResource EsDialogText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center">
                        <Button Content="{Binding CloseDialogCancelText}"
                                Command="{Binding CancelCloseDialogCommand}"
                                Padding="20,8"
                                Background="{DynamicResource EsDialogSecondaryBtn}"
                                Foreground="{DynamicResource EsTextPrimary}"
                                CornerRadius="6"/>
                        <Button Content="{Binding CloseDialogConfirmText}"
                                Command="{Binding ConfirmCloseDialogCommand}"
                                Padding="20,8"
                                Background="{DynamicResource EsErrorFg}"
                                Foreground="{DynamicResource EsTextOnAccent}"
                                FontWeight="SemiBold"
                                CornerRadius="6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
