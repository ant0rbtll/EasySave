<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasySave.GUI.ViewModels"
        xmlns:views="using:EasySave.GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EasySave.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/easysave-icon.png"
        Title="EasySave"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="32">
    <Grid RowDefinitions="32,*" MinHeight="0">
        <Grid Grid.Row="0"
              Background="#1E1E2E"
              IsHitTestVisible="False">
            <StackPanel x:Name="TitleBarBrand"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Image x:Name="TitleBarLogo"
                       Source="/Assets/easysave-icon.png"
                       Width="20"
                       Height="20"/>
                <TextBlock Text="EasySave"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="250,*" MinHeight="0">
            <views:SidebarView Grid.Column="0"
                               MinHeight="0"
                               DataContext="{Binding Sidebar}"/>
            <ScrollViewer Grid.Column="1"
                          MinHeight="0"
                          IsVisible="{Binding UseGlobalScroll}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl MinHeight="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                Content="{Binding ScrollablePage}"/>
            </ScrollViewer>
            <ContentControl Grid.Column="1"
                            MinHeight="0"
                            IsVisible="{Binding !UseGlobalScroll}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding FixedPage}"/>
        </Grid>
    </Grid>
</Window>
