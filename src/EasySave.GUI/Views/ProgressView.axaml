<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasySave.GUI.ViewModels"
             xmlns:models="using:EasySave.GUI.Models"
             x:Class="EasySave.GUI.Views.ProgressView"
             x:DataType="vm:ProgressViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <!-- Header row with title + bulk action buttons -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,0">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding TitleText}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding SubtitleText}" FontSize="13" Foreground="{DynamicResource EsTextTertiary}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="batch-btn"
                    Command="{Binding PlaySelectedCommand}"
                    ToolTip.Tip="{Binding PlaySelectedText}"
                    IsVisible="{Binding HasActiveBackups}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Background="{DynamicResource EsBatchPlayBg}"
                    BorderThickness="0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M8 5v14l11-7z" Foreground="{DynamicResource EsBatchPlayFg}" Width="14" Height="14"/>
                    <TextBlock Text="{Binding PlaySelectedText}"
                               Foreground="{DynamicResource EsBatchPlayFg}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Classes="batch-btn"
                    Command="{Binding PauseSelectedCommand}"
                    ToolTip.Tip="{Binding PauseSelectedText}"
                    IsVisible="{Binding HasActiveBackups}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Background="{DynamicResource EsBatchPauseBg}"
                    BorderThickness="0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M6 5h4v14H6zM14 5h4v14h-4z" Foreground="{DynamicResource EsBatchPauseFg}" Width="14" Height="14"/>
                    <TextBlock Text="{Binding PauseSelectedText}"
                               Foreground="{DynamicResource EsBatchPauseFg}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Classes="batch-btn"
                    Command="{Binding AskStopSelectedCommand}"
                    ToolTip.Tip="{Binding StopSelectedText}"
                    IsVisible="{Binding HasActiveBackups}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Background="{DynamicResource EsBatchStopBg}"
                    BorderThickness="0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M6 6h12v12H6z" Foreground="{DynamicResource EsBatchStopFg}" Width="14" Height="14"/>
                    <TextBlock Text="{Binding StopSelectedText}"
                               Foreground="{DynamicResource EsBatchStopFg}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <CheckBox Grid.Column="4"
                      IsChecked="{Binding IsAllSelected}"
                      ToolTip.Tip="{Binding SelectAllTooltip}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasActiveBackups}"/>
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="2"
                Margin="0,18,0,0"
                BorderBrush="{DynamicResource EsBorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding !HasActiveBackups}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="0,80">
                <PathIcon Data="M3 13h2v8H3v-8zm8-6h2v14h-2V7zm8-4h2v18h-2V3z"
                          Foreground="{DynamicResource EsEmptyIcon}"
                          Width="44"
                          Height="44"/>
                <TextBlock Text="{Binding EmptyTitleText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource EsEmptyTitle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptySubtitleText}"
                           FontSize="13"
                           Foreground="{DynamicResource EsEmptySubtitle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="500"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Active backups list -->
        <ScrollViewer Grid.Row="2"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasActiveBackups}">
            <ItemsControl ItemsSource="{Binding ActiveBackups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ActiveBackupProgressItem">
                        <Border Classes="progress-card" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*,Auto"
                                  RowSpacing="8"
                                  ColumnSpacing="12">
                                <!-- Checkbox for selection -->
                                <CheckBox Grid.Row="0"
                                          Grid.Column="0"
                                          IsChecked="{Binding IsSelected}"
                                          Click="ItemCheckBox_Click"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource EsProgressName}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Border Classes="runtime-status-badge"
                                            Tag="{Binding RuntimeStatusTag}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RuntimeStatusText}"/>
                                    </Border>
                                    <TextBlock Text="{Binding ProgressDisplay}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource EsProgressPercent}"
                                               VerticalAlignment="Center"/>
                                    <Button Classes="runtime-control-btn"
                                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).TooltipPlay}"
                                            Click="PlayJob_Click"
                                            IsEnabled="{Binding CanPlay}"
                                            CommandParameter="{Binding Id}">
                                        <PathIcon Data="M8 5v14l11-7z" Foreground="{DynamicResource EsBatchPlayFg}" Width="14" Height="14"/>
                                    </Button>
                                    <Button Classes="runtime-control-btn"
                                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).TooltipPause}"
                                            Click="PauseJob_Click"
                                            IsEnabled="{Binding CanPause}"
                                            CommandParameter="{Binding Id}">
                                        <PathIcon Data="M6 5h4v14H6zM14 5h4v14h-4z" Foreground="{DynamicResource EsBatchPauseFg}" Width="14" Height="14"/>
                                    </Button>
                                    <Button Classes="runtime-control-btn"
                                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).TooltipStop}"
                                            Click="StopJob_Click"
                                            IsEnabled="{Binding CanStop}"
                                            CommandParameter="{Binding Id}">
                                        <PathIcon Data="M6 6h12v12H6z" Foreground="{DynamicResource EsBatchStopFg}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>

                                <ProgressBar Grid.Row="1"
                                             Grid.ColumnSpan="3"
                                             Classes="active-progress"
                                             Value="{Binding ProgressPercent}"/>

                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="Auto,Auto,20,Auto,Auto,20,Auto,Auto">
                                    <TextBlock Grid.Column="0" Classes="meta-label" Text="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).FilesLabelText}"/>
                                    <TextBlock Grid.Column="1" Classes="meta-value" Text="{Binding FilesDisplay}" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="3" Classes="meta-label" Text="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).SizeLabelText}"/>
                                    <TextBlock Grid.Column="4" Classes="meta-value" Text="{Binding SizeDisplay}" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="6" Classes="meta-label" Text="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).UpdatedAtLabelText}"/>
                                    <TextBlock Grid.Column="7" Classes="meta-value" Text="{Binding UpdatedAtDisplay}" Margin="6,0,0,0"/>
                                </Grid>

                                <Grid Grid.Row="3"
                                      Grid.ColumnSpan="3"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="5">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="meta-label" Text="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).CurrentSourceLabelText}"/>
                                        <TextBlock Classes="meta-value" Text="{Binding CurrentSourcePath}" MaxWidth="780"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="meta-label" Text="{Binding $parent[UserControl].((vm:ProgressViewModel)DataContext).CurrentDestinationLabelText}"/>
                                        <TextBlock Classes="meta-value" Text="{Binding CurrentDestinationPath}" MaxWidth="780"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Stop confirmation dialog -->
        <Border Grid.RowSpan="3"
                Background="{DynamicResource EsSurfaceOverlay}"
                IsVisible="{Binding IsStopDialogOpen}">
            <Border Background="{DynamicResource EsDialogBg}"
                    CornerRadius="10"
                    Padding="32,24"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #60000000">
                <StackPanel Spacing="20">
                    <TextBlock Text="{Binding ConfirmStopTitleText}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <!-- Single stop message -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="4"
                                IsVisible="{Binding !IsStopSelectedMode}">
                        <TextBlock Text="{Binding ConfirmStopMessageText}"
                                   FontSize="14"
                                   Foreground="{DynamicResource EsDialogText}"/>
                        <TextBlock Text="{Binding PendingStopJobName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource EsTextOnAccent}"/>
                        <TextBlock Text="?"
                                   FontSize="14"
                                   Foreground="{DynamicResource EsDialogText}"/>
                    </StackPanel>
                    <!-- Multi stop message -->
                    <TextBlock Text="{Binding ConfirmStopSelectedMessageText}"
                               FontSize="14"
                               Foreground="{DynamicResource EsDialogText}"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding IsStopSelectedMode}"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center">
                        <Button Content="{Binding CancelText}"
                                Command="{Binding CancelStopJobCommand}"
                                Padding="20,8"
                                Background="{DynamicResource EsDialogSecondaryBtn}"
                                Foreground="{DynamicResource EsTextOnAccent}"
                                CornerRadius="6"/>
                        <!-- Single stop confirm -->
                        <Button Content="{Binding StopText}"
                                Command="{Binding ConfirmStopJobCommand}"
                                Padding="20,8"
                                Background="{DynamicResource EsBatchStopFg}"
                                Foreground="{DynamicResource EsTextOnAccent}"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                IsVisible="{Binding !IsStopSelectedMode}"/>
                        <!-- Multi stop confirm -->
                        <Button Content="{Binding StopText}"
                                Command="{Binding ConfirmStopSelectedCommand}"
                                Padding="20,8"
                                Background="{DynamicResource EsBatchStopFg}"
                                Foreground="{DynamicResource EsTextOnAccent}"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                IsVisible="{Binding IsStopSelectedMode}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
