@startuml
title EasySave 1.1 - Diagramme de classes (architecture actuelle)

skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

package "Core" {
  enum BackupType {
    Complete
    Differential
  }

  enum LogFormat {
    Json
    Xml
  }

  class BackupJob {
    +Id : int
    +Name : string
    +Source : string
    +Destination : string
    +Type : BackupType
  }

  BackupJob --> BackupType
}

package "Application" {
  class BackupApplicationService {
    +CreateJob(name, source, destination, type) : void
    +RemoveJob(id) : void
    +UpdateJob(job) : void
    +RunJob(id) : void
    +RunJobs(ids[]) : void
    +RunAllJobs() : void
    +GetAllJobs() : List<BackupJob>
    +GetJob(id) : BackupJob?
  }
}

package "Persistence" {
  interface IBackupJobRepository {
    +{static} DefaultMaxJobs : int = 5
    +Add(job) : void
    +Remove(id) : void
    +GetById(id) : BackupJob?
    +GetAll() : List<BackupJob>
    +Count() : int
    +MaxJobs() : int
    +Update(job) : void
  }

  class JsonBackupJobRepository
  class InMemoryBackupJobRepository

  interface IJobIdProvider {
    +NextId(existing) : int
  }

  class SequentialJobIdProvider

  class UserPreferences {
    +Language : string
    +LogDirectory : string?
    +LogFormat : LogFormat
  }

  interface IUserPreferencesRepository {
    +Load() : UserPreferences
    +Save(preferences) : void
  }

  class JsonUserPreferencesRepository

  IBackupJobRepository <|.. JsonBackupJobRepository
  IBackupJobRepository <|.. InMemoryBackupJobRepository
  IJobIdProvider <|.. SequentialJobIdProvider
  IUserPreferencesRepository <|.. JsonUserPreferencesRepository

  JsonBackupJobRepository --> IJobIdProvider
  InMemoryBackupJobRepository --> IJobIdProvider
  UserPreferences --> Core.LogFormat
}

package "Backup" {
  interface IBackupEngine {
    +Execute(job) : void
  }

  class BackupEngine {
    +Execute(job) : void
  }

  IBackupEngine <|.. BackupEngine
}

package "System" {
  interface IFileSystem
  class DefaultFileSystem

  interface ITransferService {
    +TransferFile(sourcePath, destinationPath, overwrite) : TransferResult
  }

  class DefaultTransferService

  class TransferResult {
    +FileSizeBytes : long
    +TransferTimeMs : long
    +ErrorCode : int
    +IsSuccess : bool
  }

  IFileSystem <|.. DefaultFileSystem
  ITransferService <|.. DefaultTransferService
  DefaultTransferService --> IFileSystem
  DefaultTransferService ..> TransferResult
}

package "State" {
  enum BackupStatus {
    Inactive
    Active
    Done
    Error
  }

  class StateEntry {
    +BackupId : int
    +BackupName : string?
    +Status : BackupStatus
    +ProgressPercent : int
    +CurrentSourcePath : string?
    +CurrentDestinationPath : string?
  }

  class GlobalState {
    +UpdatedAt : DateTime
    +Entries : Dictionary<int, StateEntry>
  }

  interface IStateWriter {
    +Update(entry) : void
    +MarkInactive(backupId) : void
  }

  class RealTimeStateWriter

  class StateSerializer {
    +{static} ToPrettyJson(state) : string
  }

  IStateWriter <|.. RealTimeStateWriter
  RealTimeStateWriter --> GlobalState
  RealTimeStateWriter ..> StateSerializer
  StateEntry --> BackupStatus
}

package "Configuration" {
  interface IPathProvider {
    +GetDailyLogPath(date, format) : string
    +GetStatePath() : string
    +GetJobsConfigPath() : string
    +GetUserPreferencesPath() : string
    +SetLogDirectoryOverride(directory) : void
  }

  class DefaultPathProvider

  IPathProvider <|.. DefaultPathProvider
}

package "Localization" {
  enum LocalizationKey

  interface ILocalizationService {
    +Culture : string
    +AllCultures : Dictionary<string, LocalizationKey>
    +TranslateText(key) : string
    +TranslateTextWithParams(key, parameters[]) : string
  }

  class LocalizationService

  ILocalizationService <|.. LocalizationService
}

package "Log" {
  enum LogEventType {
    CreateDirectory
    TransferFile
    Error
    StartBackup
    EndBackup
  }

  class LogEntry <<record>> {
    +Timestamp : DateTime
    +BackupName : string
    +EventType : LogEventType
    +SourcePathUNC : string
    +DestinationPathUNC : string
    +FileSizeBytes : long
    +TransferTimeMs : long
  }

  interface ILogger {
    +Write(entry) : void
  }

  class NoOpLogger

  ILogger <|.. NoOpLogger
  LogEntry --> LogEventType
}

package "EasyLog" {
  interface ILogFormatter {
    +Format(entry) : string
  }

  interface ILogFileLayout {
    +GetFileHeader() : string
    +GetFileFooter() : string
    +GetEntrySeparator() : string
    +GetIndentSpaces() : int
  }

  class JsonLogFormatter
  class XmlLogFormatter

  class DailyFileLogger {
    +Write(entry) : void
    +Dispose() : void
  }

  ILogFormatter <|.. JsonLogFormatter
  ILogFormatter <|.. XmlLogFormatter
  ILogFileLayout <|.. JsonLogFormatter
  ILogFileLayout <|.. XmlLogFormatter
}

package "UI" {
  enum JobEditableField {
    Name
    Source
    Destination
    Type
  }

  class Program {
    +{static} Main(args[]) : void
    -{static} InitServices() : IServiceProvider
    -{static} CreateLogger(pathProvider) : ILogger
  }

  class ConsoleUI {
    +LocalizationService : ILocalizationService
    +MainMenu() : void
    +RunFromArgs(args[]) : void
    +Quit() : void
  }

  class CommandLineParser {
    +Parse(args[]) : int[]
  }

  class ErrorManager {
    +TryGetMessage(message, key) : bool
  }

  interface IMenuService
  class MenuService

  interface IMenuFactory
  class MenuFactory

  class MenuConfig

  interface IConsoleAdapter
  class SystemConsoleAdapter

  interface IConsoleMessageService
  class ConsoleMessageService

  interface IConsoleInputService
  class ConsoleInputService

  class JobsFlowService
  class SettingsFlowService
  class JobEditSessionService

  IMenuService <|.. MenuService
  IMenuFactory <|.. MenuFactory
  IConsoleAdapter <|.. SystemConsoleAdapter
  IConsoleMessageService <|.. ConsoleMessageService
  IConsoleInputService <|.. ConsoleInputService
}

Application.BackupApplicationService --> Persistence.IBackupJobRepository
Application.BackupApplicationService --> Backup.IBackupEngine

Backup.BackupEngine --> System.IFileSystem
Backup.BackupEngine --> System.ITransferService
Backup.BackupEngine --> State.IStateWriter
Backup.BackupEngine --> Log.ILogger
Backup.BackupEngine ..> System.TransferResult
Backup.BackupEngine ..> State.StateEntry
Backup.BackupEngine ..> Log.LogEntry

Persistence.JsonBackupJobRepository --> Configuration.IPathProvider
Persistence.JsonUserPreferencesRepository --> Configuration.IPathProvider

State.RealTimeStateWriter --> Configuration.IPathProvider

EasyLog.DailyFileLogger --> EasyLog.ILogFormatter
EasyLog.DailyFileLogger --> EasyLog.ILogFileLayout
EasyLog.DailyFileLogger --> Configuration.IPathProvider
Log.ILogger <|.. EasyLog.DailyFileLogger
EasyLog.DailyFileLogger ..> Log.LogEntry

UI.Program ..> UI.ConsoleUI
UI.Program ..> Configuration.IPathProvider
UI.Program ..> Persistence.JsonUserPreferencesRepository
UI.Program ..> EasyLog.DailyFileLogger
UI.Program ..> Log.NoOpLogger

UI.ConsoleUI --> Application.BackupApplicationService
UI.ConsoleUI --> Persistence.IUserPreferencesRepository
UI.ConsoleUI --> Configuration.IPathProvider
UI.ConsoleUI --> UI.CommandLineParser
UI.ConsoleUI --> UI.IMenuService
UI.ConsoleUI --> UI.IMenuFactory
UI.ConsoleUI --> UI.IConsoleAdapter
UI.ConsoleUI --> UI.IConsoleMessageService
UI.ConsoleUI --> UI.IConsoleInputService
UI.ConsoleUI --> UI.JobsFlowService
UI.ConsoleUI --> UI.SettingsFlowService
UI.ConsoleUI --> Localization.ILocalizationService

UI.JobsFlowService --> Application.BackupApplicationService
UI.JobsFlowService --> UI.IMenuService
UI.JobsFlowService --> UI.IMenuFactory
UI.JobsFlowService --> UI.IConsoleMessageService
UI.JobsFlowService --> UI.IConsoleInputService
UI.JobsFlowService --> UI.IConsoleAdapter
UI.JobsFlowService --> UI.JobEditSessionService
UI.JobsFlowService ..> Core.BackupJob

UI.SettingsFlowService --> Persistence.IUserPreferencesRepository
UI.SettingsFlowService --> Persistence.UserPreferences
UI.SettingsFlowService --> Configuration.IPathProvider
UI.SettingsFlowService --> Localization.ILocalizationService
UI.SettingsFlowService --> UI.IMenuService
UI.SettingsFlowService --> UI.IMenuFactory
UI.SettingsFlowService --> UI.IConsoleMessageService
UI.SettingsFlowService --> UI.IConsoleInputService
UI.SettingsFlowService --> UI.IConsoleAdapter

UI.MenuService --> Localization.ILocalizationService
UI.MenuService --> UI.IConsoleAdapter
UI.MenuFactory ..> Persistence.IBackupJobRepository : DefaultMaxJobs
UI.MenuFactory ..> UI.MenuConfig

UI.ConsoleMessageService --> Localization.ILocalizationService
UI.ConsoleMessageService --> UI.ErrorManager
UI.ConsoleMessageService --> UI.IConsoleAdapter

UI.ConsoleInputService --> UI.IConsoleMessageService
UI.ConsoleInputService --> UI.IConsoleAdapter

@enduml
