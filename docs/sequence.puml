@startuml
title EasySave 1.1 - Sequence : mode interactif, configuration et execution

actor Utilisateur as User
participant "UI.Program" as Program
participant "UI.ConsoleUI" as ConsoleUI
participant "UI.SettingsFlowService" as SettingsFlow
participant "Persistence.IUserPreferencesRepository" as PrefRepo
participant "Configuration.IPathProvider" as PathProvider
participant "UI.JobsFlowService" as JobsFlow
participant "APP.BackupApplicationService" as App
participant "Persistence.IBackupJobRepository" as Repo
participant "Backup.BackupEngine" as Engine
participant "System.ITransferService" as Transfer
participant "State.IStateWriter" as State
participant "Log.ILogger" as Logger

== Demarrage ==
User -> Program : Main(args = [])
Program -> ConsoleUI : MainMenu()

== Parametres ==
User -> ConsoleUI : Ouvre menu Parametres
ConsoleUI -> SettingsFlow : ConfigureParams(MainMenu)

alt Changer dossier de logs
  SettingsFlow -> PathProvider : SetLogDirectoryOverride(directory)
  SettingsFlow -> PrefRepo : Save(UserPreferences.LogDirectory)
else Changer format de logs (Json/Xml)
  SettingsFlow -> PrefRepo : Save(UserPreferences.LogFormat)
  note right: Le format actif change au prochain redemarrage
end

== Gestion des travaux ==
User -> ConsoleUI : Ouvre liste des travaux
ConsoleUI -> JobsFlow : ShowJobsList(MainMenu)
JobsFlow -> App : GetAllJobs()
App -> Repo : GetAll()
Repo --> App : List<BackupJob>
App --> JobsFlow : List<BackupJob>

User -> JobsFlow : Selectionne un travail puis Run
JobsFlow -> App : RunJob(jobId)
App -> Repo : GetById(jobId)
Repo --> App : BackupJob?

alt Travail trouve
  App -> Engine : Execute(job)
  Engine -> State : Update(status=Active, progress=0)
  Engine -> Logger : Write(StartBackup)

  loop Pour chaque fichier a copier
    Engine -> Transfer : TransferFile(src, dst, overwrite=true)
    Transfer --> Engine : TransferResult

    alt TransferResult.IsSuccess
      Engine -> Logger : Write(TransferFile)
      Engine -> State : Update(progress)
    else Erreur de transfert
      Engine -> Logger : Write(Error)
      Engine -> State : Update(status=Error)
      Engine --> App : exception
      App --> JobsFlow : exception
      JobsFlow -> ConsoleUI : Afficher erreur localisee
    end
  end

  Engine -> State : Update(status=Done, progress=100)
  Engine -> Logger : Write(EndBackup)
  Engine -> State : MarkInactive(jobId)
  App --> JobsFlow : retour
else Travail absent
  App --> JobsFlow : retour sans execution
end

JobsFlow -> ConsoleUI : Retour menu

@enduml
