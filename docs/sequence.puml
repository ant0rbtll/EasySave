@startuml
title EasySave 2.0 - Sequence (GUI: config puis execution backup)

actor Utilisateur as User
participant "AppCommon.Program" as Program
participant "AppCommon.ApplicationManager" as AppManager
participant "GUI.Host" as GuiHost
participant "GUI.ConfigViewModel" as ConfigVM
participant "Persistence.IUserPreferencesRepository" as PrefRepo
participant "Log.ReloadableLogger" as ReloadableLogger
participant "GUI.ManageViewModel" as ManageVM
participant "Application.BackupApplicationService" as AppService
participant "Persistence.IBackupJobRepository" as JobRepo
participant "System.IBackupExecutionGuard" as Guard
participant "Backup.BackupEngine" as Engine
participant "System.ITransferService" as Transfer
participant "Backup.IEncryptionPolicyProvider" as EncPolicyProvider
participant "Backup.IEncryptionProviderResolver" as EncResolver
participant "Backup.IEncryptionProvider" as EncProvider
participant "State.IStateWriter" as StateWriter
participant "Log.ILogger" as Logger

== Demarrage ==
User -> Program : Main(args=[])
Program -> AppManager : RunHost(GuiHost)
AppManager -> GuiHost : ConfigureServices(...)\nRun(...)

== Configuration ==
User -> ConfigVM : Save(language, logFormat, logDirectory, encryptedExtensions, businessSoftware)
ConfigVM -> PrefRepo : Load()
ConfigVM -> PrefRepo : Save(updatedPreferences)
ConfigVM -> ReloadableLogger : Reload() (si format change)

== Execution d'un job ==
User -> ManageVM : RunJob(jobId)
ManageVM -> AppService : RunJob(jobId)
AppService -> Guard : EnsureCanCopyNextFile()
AppService -> JobRepo : GetById(jobId)
JobRepo --> AppService : job?

alt job trouve
  AppService -> Engine : Execute(job)

  Engine -> EncPolicyProvider : GetPolicy()
  Engine -> StateWriter : Update(status=Active)
  Engine -> Logger : Write(StartBackup)

  loop pour chaque fichier
    Engine -> Guard : EnsureCanCopyNextFile()
    Engine -> Transfer : TransferFile(src,dst,true)
    Transfer --> Engine : TransferResult

    alt succes
      Engine -> EncResolver : Resolve(policy.ProviderName)
      EncResolver --> Engine : provider?
      alt extension chiffree et provider trouve
        Engine -> EncProvider : EncryptAsync(destinationFile, policy)
        EncProvider --> Engine : EncryptionResult
      end
      Engine -> Logger : Write(TransferFile)
      Engine -> StateWriter : Update(progress)
    else erreur transfert / guard
      Engine -> Logger : Write(Error ou BusinessSoftwareDetected)
      Engine -> StateWriter : Update(status=Error)
      Engine --> AppService : throw
      AppService --> ManageVM : throw
    end
  end

  alt execution complete
    Engine -> Logger : Write(EndBackup)
    Engine -> StateWriter : Update(status=Done)
    Engine -> StateWriter : MarkInactive(jobId)
    Engine --> AppService : ok
  end
else job absent
  AppService --> ManageVM : retour sans execution
end

@enduml
