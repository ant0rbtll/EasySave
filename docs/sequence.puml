@startuml
title EasySave 3.0 - Sequence (configuration centralisee + execution parallele)

actor Utilisateur as User
participant "AppCommon.Program" as Program
participant "AppCommon.ApplicationManager" as AppManager
participant "GUI.Host" as GuiHost
participant "GUI.ConfigViewModel" as ConfigVM
participant "Persistence.IUserPreferencesRepository" as PrefRepo
participant "AppCommon.ReloadableLogger" as ReloadableLogger
participant "GUI.ManageViewModel" as ManageVM
participant "Application.BackupApplicationService" as AppService
participant "Application.IBackupRunCoordinator" as RunCoordinator
participant "Backup.BackupEngine" as Engine
participant "Backup.BackupRuntimeGate" as RuntimeGate
participant "System.IPriorityFilesBarrier" as PriorityBarrier
participant "System.ILargeFileTransferBarrier" as LargeFileBarrier
participant "System.IBackupExecutionGuard" as Guard
participant "Backup.BackupFileExecutionService" as FileExec
participant "System.ITransferService" as Transfer
participant "Backup.IEncryptionProviderResolver" as EncResolver
participant "Backup.IEncryptionProvider" as EncProvider
participant "Backup.BackupExecutionReporter" as Reporter
participant "State.IStateWriter" as StateWriter
participant "Log.ILogger" as Logger
participant "AppCommon.ResilientHttpLogSender" as ResilientSender
participant "AppCommon.HttpLogSender" as HttpSender
participant "LogServer.API" as LogServer
participant "GUI.ProgressViewModel" as ProgressVM
participant "Application.IStateReader" as StateReader
participant "Application.IBackupEtaEstimator" as EtaEstimator

== Demarrage ==
User -> Program : Main(args=[])
Program -> AppManager : RunHost(GuiHost)
AppManager -> GuiHost : ConfigureServices(...)
AppManager -> GuiHost : Run(...)

== Configuration ==
User -> ConfigVM : Save(logMode, logServerUrl, priorites, seuil gros fichier, langue...)
ConfigVM -> PrefRepo : Load()
ConfigVM -> PrefRepo : Save(updatedPreferences)
ConfigVM -> ReloadableLogger : Reload() (si config logs modifiee)

== Lancement de plusieurs jobs ==
User -> ManageVM : RunSelected(jobIds)
ManageVM -> AppService : RunJobs(jobIds)

loop Pour chaque job (parallel)
  AppService -> RunCoordinator : RunExclusiveAsync(jobId, run)
  RunCoordinator -> Engine : Execute(job, executionContext)

  Engine -> RuntimeGate : BeginJob(jobId)
  Engine -> RuntimeGate : RegisterPriorityJob(jobId, pendingPriorityCount)
  Engine -> Reporter : UpdateState(Active)
  Engine -> Reporter : Log(StartBackup)

  loop Pour chaque fichier planifie
    Engine -> RuntimeGate : WaitForRuntimeControlAndSyncState(...)

    alt Fichier non prioritaire
      Engine -> PriorityBarrier : WaitUntilNoPriorityPendingAsync()
      RuntimeGate -> Reporter : UpdateState(Waiting)
    end

    RuntimeGate -> Guard : EnsureCanCopyNextFile()

    RuntimeGate -> LargeFileBarrier : TryAcquire(fileSize, threshold)
    alt Slot gros fichier indisponible
      RuntimeGate -> Reporter : UpdateState(Waiting)
    end

    Engine -> FileExec : TransferAndEncrypt(plan, policy)
    FileExec -> Transfer : TransferFile(src, dst, overwrite=true)
    Transfer --> FileExec : TransferResult

    alt Extension chiffree
      FileExec -> EncResolver : Resolve(providerName)
      EncResolver --> FileExec : provider?
      FileExec -> EncProvider : EncryptAsync(dst, policy)
      EncProvider --> FileExec : EncryptionResult
    end

    Engine -> Reporter : Log(TransferFile)
    Engine -> Reporter : UpdateState(progress + remaining)
  end

  alt Fin normale
    Engine -> Reporter : Log(EndBackup)
    Engine -> Reporter : UpdateState(Done)
    Engine -> StateWriter : MarkInactive(jobId)
  else Erreur / Stop
    Engine -> Reporter : Log(Error | Stopped)
    Engine -> Reporter : UpdateState(Error)
  end

  Engine -> RuntimeGate : UnregisterPriorityJob(jobId)
  Engine -> RuntimeGate : EndJob(jobId)
end

== Acheminement log centralise ==
Reporter -> Logger : Write(LogEntry)
Logger -> ResilientSender : Write(LogEntry)
ResilientSender -> HttpSender : POST /api/logs
HttpSender -> LogServer : /api/logs

== Supervision live GUI ==
loop Toutes les 500 ms
  ProgressVM -> AppService : GetAllJobsLiveProgress()
  AppService -> StateReader : ReadEntries()
  AppService -> EtaEstimator : UpdateEstimate(...)
  AppService --> ProgressVM : Etats actifs + ETA
end

@enduml
