@startuml
title EasySave 2.0 - Activite : execution d'un backup avec garde metier et chiffrement

start

:Charger le job;
:Verifier les processus metier interdits (pre-check);

if (Processus metier detecte ?) then (Oui)
  :Lever exception
(error_business_software_running);
  :Logger BusinessSoftwareDetected;
  :Etat = Error;
  stop
endif

:Enumerer les fichiers source;
:Charger la policy de chiffrement;
:Etat = Active (0%);
:Logger StartBackup;

repeat
  :Determiner le fichier suivant;

  if (Type Differential et fichier inchange ?) then (Oui)
    :Passer au fichier suivant;
  else (Non)
    :Verifier processus metier\navant copie du fichier;
    if (Processus metier detecte ?) then (Oui)
      :Lever exception\n(error_business_software_running);
      :Logger BusinessSoftwareDetected;
      :Etat = Error;
      stop
    endif

    :Creer dossier destination si absent;
    :Transferer le fichier;

    if (Transfert OK ?) then (Oui)
      if (Extension chiffree ?) then (Oui)
        :Resoudre provider;
        :Chiffrer le fichier transfere;
      endif
      :Logger TransferFile;
      :Mettre a jour progression;
      :Etat = Active;
    else (Non)
      :Logger Error;
      :Etat = Error;
      stop
    endif
  endif

repeat while (Fichiers restants ?)

:Etat = Done (100%);
:Logger EndBackup;
:MarkInactive(jobId);

stop
@enduml
