@startuml
title EasySave 3.0 - Activite : execution d'un backup avec controles runtime

start

:Charger le job;
:Charger le contexte d'execution
(priorites, seuil gros fichier, policy chiffrement);
:Planifier les fichiers (ordre + priorites + shouldCopy);
:RegisterPriorityJob(jobId, pendingPriorityFiles);
:Etat = Active (0%);
:Logger StartBackup;

repeat
  :Selectionner le fichier suivant;

  :Verifier pause/reprise/arret utilisateur;
  if (Arret demande ?) then (Oui)
    :Logger Stopped;
    :MarkInactive(jobId);
    :UnregisterPriorityJob(jobId);
    stop
  endif

  if (Fichier a copier ?) then (Non)
    :Passer au fichier suivant;
  else (Oui)

    if (Fichier non prioritaire
et priorites globales en attente ?) then (Oui)
      :Etat = Waiting;
      :Attendre liberation
barriere priorites;
      :Etat = Active;
    endif

    while (Logiciel metier detecte ?) is (Oui)
      :Etat = Blocked;
      :Logger BusinessSoftwareDetected (une fois);
      :Attendre puis re-verifier;
    endwhile (Non)

    if (Fichier > seuil gros fichiers ?) then (Oui)
      while (Slot gros fichier indisponible ?) is (Oui)
        :Etat = Waiting;
        :Attendre slot ILargeFileTransferBarrier;
      endwhile (Non)
      :Etat = Active;
    endif

    :Creer dossier destination si absent;
    :Transferer le fichier;

    if (Transfert OK ?) then (Non)
      :Etat = Error;
      :Logger Error;
      :UnregisterPriorityJob(jobId);
      stop
    else (Oui)
      if (Extension chiffree ?) then (Oui)
        :Resoudre provider;
        :Chiffrer le fichier
(echec chiffrement non bloquant);
      endif

      if (Fichier prioritaire ?) then (Oui)
        :MarkPriorityFileCompleted(jobId);
      endif

      :Mettre a jour remaining/progress;
      :Etat = Active;
      :Logger TransferFile;
    endif
  endif

repeat while (Fichiers restants ?)

:Etat = Done (100%);
:Logger EndBackup;
:MarkInactive(jobId);
:UnregisterPriorityJob(jobId);

stop
@enduml
