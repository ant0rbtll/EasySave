@startuml
title EasySave 1.1 - Activite : edition de travail avec gestion des modifications non sauvegardees

start

:ConsoleUI.MainMenu();

if (Choix = Gerer les travaux ?) then (Oui)
  :JobsFlowService.ShowJobsList();
else (Non)
  :Retour au menu principal;
  stop
endif

:Selection du travail;
:Afficher details du travail;

if (Choix = Modifier ?) then (Oui)
  :JobsFlowService.UpdateJob(job);
  :JobEditSessionService.BeginOrRefresh(job);
else (Non)
  :Retour details travail;
  stop
endif

repeat
  :Afficher menu de mise a jour;

  if (Choix champ editable ?) then (Oui)
    :MenuFactory envoie JobEditableField\n(Name/Source/Destination/Type);
    :UpdateJobField(...);
    :Saisie via ConsoleInputService;
  else (Non)
  endif

  if (Choix = Sauvegarder ?) then (Oui)
    :BackupApplicationService.UpdateJob(job);
    :JobEditSessionService.Clear();
    :Message succes;
    :Retour liste des travaux;
    stop
  else (Non)
  endif

repeat while (Choix != Retour)

if (Retour depuis edition) then (Oui)
  if (Modifications en attente ?) then (Oui)
    :Afficher menu "Unsaved Changes";

    if (Save and quit) then (Oui)
      :BackupApplicationService.UpdateJob(job);
      :JobEditSessionService.Clear();
      :Retour details travail;
      stop
    else (Non)
      if (Discard and quit) then (Oui)
        :JobEditSessionService.Restore(job);
        :JobEditSessionService.Clear();
        :Retour details travail;
        stop
      else (Back)
        :Retour menu edition;
      endif
    endif
  else (Non)
    :JobEditSessionService.Clear();
    :Retour details travail;
    stop
  endif
endif

stop
@enduml
