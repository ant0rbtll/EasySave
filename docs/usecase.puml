@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Utilisateur" as User

rectangle "EasySave 2.0" {
  usecase "Lancer l'application" as UC_Start
  usecase "Utiliser l'interface GUI" as UC_GUI
  usecase "Executer un job\n(en une ligne CLI)" as UC_CLI_OneLine

  usecase "Gerer les jobs" as UC_Manage
  usecase "Creer un job" as UC_Create
  usecase "Modifier un job" as UC_Update
  usecase "Supprimer un job" as UC_Delete
  usecase "Executer un job" as UC_RunOne

  usecase "Consulter les logs" as UC_Logs
  usecase "Naviguer logs par date/job/run" as UC_LogNav

  usecase "Configurer l'application" as UC_Config
  usecase "Configurer langue" as UC_Language
  usecase "Configurer format de log" as UC_LogFormat
  usecase "Configurer dossier de logs" as UC_LogDir
  usecase "Configurer extensions chiffrees" as UC_EncExtensions
  usecase "Configurer logiciels metier surveilles" as UC_BusinessProc

  usecase "Bloquer execution si logiciel metier detecte" as UC_BusinessGuard
  usecase "Chiffrer fichiers selon policy" as UC_Encrypt
}

User --> UC_Start
User --> UC_CLI_OneLine

UC_Start .> UC_GUI : <<include>>

UC_GUI .> UC_Manage : <<include>>
UC_GUI .> UC_Logs : <<include>>
UC_GUI .> UC_Config : <<include>>

UC_Manage .> UC_Create : <<include>>
UC_Manage .> UC_Update : <<include>>
UC_Manage .> UC_Delete : <<include>>
UC_Manage .> UC_RunOne : <<include>>

UC_Logs .> UC_LogNav : <<include>>

UC_Config .> UC_Language : <<include>>
UC_Config .> UC_LogFormat : <<include>>
UC_Config .> UC_LogDir : <<include>>
UC_Config .> UC_EncExtensions : <<include>>
UC_Config .> UC_BusinessProc : <<include>>

UC_RunOne .> UC_BusinessGuard : <<include>>
UC_RunOne .> UC_Encrypt : <<include>>
UC_CLI_OneLine .> UC_RunOne : <<include>>

@enduml
